---
/**
 * Slide 02 — "text goes in, labelled results come out".
 *
 * One flat left-to-right lane: neutral text lines feed the plinth, lit label
 * chips leave it. Every wire is a hairline rotated about its origin, so its
 * brightness gradient and its travelling dot always run the same way — towards
 * the labels.
 */
const TEXT_LINES = [96, 80, 100, 72, 46] as const;

/** Right corner of the plinth top face: where every output wire starts. */
const OUT = { x: 406, y: 176 } as const;
const CHIP_X = 470;

const chips = [
  { label: 'positive', y: 108, delay: '-1.5s' },
  { label: 'neutral', y: 176, delay: '-0.75s' },
  { label: 'negative', y: 244, delay: '0s' },
] as const;

const wires = chips.map((chip, i) => {
  const dx = CHIP_X - OUT.x;
  const dy = chip.y - OUT.y;

  return {
    ...chip,
    length: `${Math.hypot(dx, dy).toFixed(1)}px`,
    angle: `${((Math.atan2(dy, dx) * 180) / Math.PI).toFixed(2)}deg`,
    chipDelay: `${(0.42 + i * 0.09).toFixed(2)}s`,
  };
});
---

<div class="v-skl">
  <div class="doc">
    {TEXT_LINES.map((width) => <span class="ln" style={`width:${width}px`} />)}
  </div>

  <span class="wire in" style="--x:130px;--y:176px;--l:60px;--a:0deg">
    <i class="dot" style="--delay:-1.1s"></i>
    <i class="dot" style="--delay:-0.2s"></i>
  </span>

  <div class="gr" style="--gx:298px;--gy:252px;--gs:.56;--gi:.9">
    <div class="pool"></div>
    <div class="mesh"></div>
    <div class="survey"></div>
    <div class="shd"></div>
  </div>
  <div class="glow" style="--ex:298px;--ey:214px;--ew:230px;--ei:.28"></div>

  <div class="pl" style="--cx:298px;--cy:176px;--pw:152px;--pt:24px;--rim:.9">
    <div class="fr"></div>
    <div class="lf"></div>
    <div class="top">
      <div class="face-in">
        <img src="/logos/scikit-llm.svg" alt="" width="52" height="52" />
      </div>
    </div>
  </div>

  {
    wires.map((wire) => (
      <span
        class="wire out"
        style={`--x:${OUT.x}px;--y:${OUT.y}px;--l:${wire.length};--a:${wire.angle}`}
      >
        <i class="dot" style={`--delay:${wire.delay}`} />
      </span>
    ))
  }

  {
    wires.map((wire) => (
      <div class="chip" style={`--y:${wire.y}px;--delay:${wire.chipDelay}`}>
        <span class="d" />
        <span class="n">{wire.label}</span>
      </div>
    ))
  }
</div>

<style>
  .v-skl {
    position: absolute;
    inset: 0;
  }

  /* Raw input: unlabelled, uncoloured lines of text. */
  .doc {
    position: absolute;
    left: 20px;
    top: 176px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    animation: sklFade 0.7s ease 0.1s backwards;
  }

  .doc .ln {
    height: 5px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.4);
  }

  @keyframes sklFade {
    from {
      opacity: 0;
    }
  }

  .wire {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--l);
    height: 1px;
    transform-origin: 0 50%;
    transform: rotate(var(--a));
  }

  .wire.in {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.34));
  }

  .wire.out {
    background: linear-gradient(90deg, rgba(255, 117, 0, 0.12), rgba(255, 117, 0, 0.62));
  }

  /* Dots rest at the far end of their wire, so a still frame still reads as arrival. */
  .wire .dot {
    position: absolute;
    top: -2px;
    left: 100%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    animation: sklFlow 2.2s linear var(--delay, 0s) infinite;
  }

  .wire.in .dot {
    background: #e6eaee;
    box-shadow: 0 0 8px 1px rgba(255, 255, 255, 0.45);
  }

  .wire.out .dot {
    background: var(--color-accent-soft);
    box-shadow: 0 0 10px 2px rgba(255, 117, 0, 0.8);
  }

  @keyframes sklFlow {
    0% {
      left: 0%;
      opacity: 0;
    }
    16% {
      opacity: 1;
    }
    84% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  /* Output: every chip lit the same, because a label is a label. */
  .chip {
    position: absolute;
    left: 470px;
    top: var(--y);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 28px;
    padding: 0 13px;
    border: 1px solid rgba(255, 117, 0, 0.36);
    border-radius: 999px;
    background: rgba(255, 117, 0, 0.08);
    box-shadow:
      0 0 20px -6px rgba(255, 117, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    animation: sklChipIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--delay) backwards;
  }

  @keyframes sklChipIn {
    from {
      opacity: 0;
      transform: translateY(-50%) translateX(-12px);
    }
  }

  .chip .d {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex: 0 0 auto;
    background: var(--color-accent);
    box-shadow: 0 0 10px 1px rgba(255, 117, 0, 0.9);
  }

  .chip .n {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: #d8dde2;
  }
</style>
