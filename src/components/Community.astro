    -webkit-mask-image: radial-gradient(
      closest-side,
      #000 8%,
      rgba(0, 0, 0, 0.45) 44%,
      transparent 74%
    );
    mask-image: radial-gradient(closest-side, #000 8%, rgba(0, 0, 0, 0.45) 44%, transparent 74%);
    opacity: 0.46;
  }

  .g-ring {
    left: -152px;
    top: -152px;
    width: 304px;
    height: 304px;
    border: 1px dashed rgba(255, 117, 0, 0.4);
    border-radius: 50%;
    transform: rotateX(56deg) rotateZ(-45deg);
  }

  .g-ring::after {
    content: "";
    position: absolute;
    inset: 34px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 50%;
  }

  .g-shadow {
    left: -120px;
    top: -120px;
    width: 240px;
    height: 240px;
    transform: rotateX(56deg);
    background: radial-gradient(
      closest-side,
      rgba(0, 0, 0, 0.85),
      rgba(0, 0, 0, 0.3) 50%,
      transparent 76%
    );
    filter: blur(12px);
  }

  /* ---------------- the mark, rebuilt from the section's own geometry ---------------- */
  .phx {
    position: absolute;
    left: 50%;
    top: 18px;
    width: 276px;
    height: 276px;
    margin-left: -138px;
    overflow: visible;
    filter: drop-shadow(0 0 18px rgba(255, 117, 0, 0.18));
  }

  .phx .halo {
    animation: breathe 8s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    from {
      opacity: 0.72;
    }
    to {
      opacity: 1;
    }
  }

  /* Ignition: the ember light climbs the mark once, then rests lit. */
  .phx .ignite {
    animation: ignite 2.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;
  }

  @keyframes ignite {
    from {
      transform: translateY(330px);
    }
  }

  .phx .fine {
    animation: driftUp 9s ease-in-out infinite alternate;
  }

  @keyframes driftUp {
    from {
      transform: translateY(5px);
    }
    to {
      transform: translateY(-5px);
    }
  }

  .phx .edge {
    animation: fadeIn 1.1s ease 0.35s backwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
  }

  /* ---------------- loose embers ---------------- */
  .air {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .air i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: var(--color-accent-soft);
    opacity: var(--o);
    box-shadow: 0 0 7px 0 rgba(255, 117, 0, 0.65);
    animation: rise var(--dur) linear var(--delay) infinite;
  }

  @keyframes rise {
    0% {
      transform: translateY(90px);
      opacity: 0;
    }
    22% {
      opacity: var(--o);
    }
    78% {
      opacity: var(--o);
    }
    100% {
      transform: translateY(-120px);
      opacity: 0;
    }
