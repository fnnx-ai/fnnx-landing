  }

  /* The band's own light: one warm pool centred on the mark. */
  .finale::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 46% at 50% 52%, rgba(255, 117, 0, 0.14), transparent 68%),
      radial-gradient(90% 40% at 50% 100%, rgba(255, 117, 0, 0.05), transparent 72%);
