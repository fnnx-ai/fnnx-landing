      rgba(255, 117, 0, 0.05) 48%,
      transparent 74%
    );
    filter: blur(18px);
  }

  .g-grid {
    left: -250px;
    top: -250px;
    width: 500px;
    height: 500px;
    transform: rotateX(56deg) rotateZ(-45deg);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
