  .fin-in {
    position: relative;
    z-index: 1;
  }

  /* ---------------- the rig ---------------- */
  .stage {
    position: relative;
    height: 356px;
    margin-top: 4px;
  }

  .ground {
    position: absolute;
    left: 50%;
    top: 300px;
    width: 0;
